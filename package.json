  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.20",
    "geojson": "0.5.0",
    "gh-pages": "6.3.0",
    "leaflet": "1.9.4",
    "lit": "3.3.1",
    "typedoc": "0.28.11",
    "typescript": "5.9.2",
    "validate-package-exports": "0.13.0",
    "vite": "7.1.3",
    "vite-plugin-dts": "4.5.4"
  },
  "dependencies": {
  },
  "files": [
    "dist/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
